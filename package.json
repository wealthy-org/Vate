{
  "name": "vate",
  "version": "0.1.0",
  "private": true,
  "description": "VATE — non-custodial interface for curated USDG vaults on Robinhood Chain",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "cross-env NEXT_TELEMETRY_DISABLED=1 next dev -H 0.0.0.0 -p 3000",
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "cross-env NEXT_TELEMETRY_DISABLED=1 next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:fork": "cross-env RUN_FORK=1 vitest run --project fork",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test",
    "contracts:export": "node scripts/export-artifacts.mjs",
    "deploy:testnet": "node scripts/deploy-testnet.mjs",
    "showcase:mainnet": "node scripts/showcase-mainnet.mjs",
    "verify:mappings": "node scripts/verify-mappings.mjs",
    "qa:screens": "node scripts/qa-screens.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:all": "pnpm typecheck && pnpm test && pnpm contracts:test && pnpm test:integration",
    "fork": "node scripts/dev-fork.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "next": "16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "viem": "^2.57.17",
    "wagmi": "3.7.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "cross-env": "^10.1.0",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
